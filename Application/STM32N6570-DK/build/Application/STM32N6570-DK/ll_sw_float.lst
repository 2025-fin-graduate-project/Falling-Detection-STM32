 257:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h **** /*!
 258:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****  * @brief Check whether 2 shapes have identical dimensions.
 259:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****  * @ingroup datatypes_internal
 260:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****  * @param shape0 the 1st tensor shape to compare
 261:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****  * @param shape1 the 2nd tensor shape to compare
 262:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****  * @return true if shape0 and shape1 have same dimensions. false otherwise
 263:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****  */
 264:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h **** AI_DECLARE_STATIC
 265:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h **** ai_bool ai_shape_is_same(
 266:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****   const ai_shape* shape0, const ai_shape* shape1)
 267:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h **** {
 268:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****   AI_ASSERT(shape0 && shape1)
 269:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****   if (AI_SHAPE_SIZE(shape0) != AI_SHAPE_SIZE(shape1))
 270:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****     return false;
 271:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****   ai_size dim = AI_SHAPE_SIZE(shape0);
 272:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****   while ( dim>0 ) {
 273:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****     dim--;
 274:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****     if ( AI_SHAPE_ELEM(shape0, dim)!=AI_SHAPE_ELEM(shape1, dim) )
 275:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****       return false;
 276:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****   }
 277:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h ****   return true;
 278:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h **** }
 279:../../Middlewares/stedgeai-lib/Inc/ai_datatypes_internal.h **** 
