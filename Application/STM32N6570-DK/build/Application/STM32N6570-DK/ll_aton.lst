 173:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   /* Clear pipeline */
 174:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   t = ATON_CLKCTRL_CTRL_GET(0);
 175:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   t = ATON_CLKCTRL_CTRL_SET_CLR(t, 1);
 176:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   ATON_CLKCTRL_CTRL_SET(0, t);
 177:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c **** 
 178:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   /* Enable all ATON clocks */
 179:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   ATON_CLKCTRL_CTRL_SET(0, 1);
 180:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   ATON_CLKCTRL_AGATES0_SET(0, 0xffffffff);
 181:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c ****   ATON_CLKCTRL_AGATES1_SET(0, 0xffffffff);
 182:../../Middlewares/stedgeai-lib/Npu/ll_aton/ll_aton.c **** 
