 574:Src/main.c    ****   float32_t normal_exp = expf(logits[0] - max_logit);
 575:Src/main.c    ****   float32_t fall_exp   = expf(logits[1] - max_logit);
 576:Src/main.c    ****   float32_t denom      = normal_exp + fall_exp;
 577:Src/main.c    **** 
 578:Src/main.c    ****   if (denom > 0.0f)
 579:Src/main.c    ****   {
 580:Src/main.c    ****     fall_state.normal_score = normal_exp / denom;
 581:Src/main.c    ****     fall_state.fall_score   = fall_exp   / denom;
 582:Src/main.c    ****   }
 583:Src/main.c    ****   else
 584:Src/main.c    ****   {
 585:Src/main.c    ****     fall_state.normal_score = 0.5f;
 586:Src/main.c    ****     fall_state.fall_score   = 0.5f;
 587:Src/main.c    ****   }
 588:Src/main.c    **** 
 589:Src/main.c    ****   if (fall_state.window_ready)
 590:Src/main.c    ****     fall_state.fall_detected = (fall_state.fall_score >= fall_state.normal_score) ? 1u : 0u;
 591:Src/main.c    **** }
