 449:Src/main.c    **** static void FallDetection_Update(PosePipeline_t *pipeline)
 450:Src/main.c    **** {
 451:Src/main.c    ****   fall_state.frame_count = pipeline->win_count;
 452:Src/main.c    ****   fall_state.window_ready = PosePipeline_WindowFull(pipeline);
 453:Src/main.c    **** 
 454:Src/main.c    ****   if (!fall_state.window_ready)
ARM GAS  /tmp/ccvPZskd.s 			page 48


 455:Src/main.c    ****   {
 456:Src/main.c    ****     fall_state.fall_detected = 0;
 457:Src/main.c    ****     fall_state.fall_score = 0.0f;
 458:Src/main.c    ****     fall_state.normal_score = 0.0f;
 459:Src/main.c    ****     fall_state.tcn_inference_ms = 0;
 460:Src/main.c    ****     return;
 461:Src/main.c    ****   }
 462:Src/main.c    **** 
 463:Src/main.c    ****   PosePipeline_GetWindowFeaturesFirst(pipeline, (float32_t (*)[POSE_WINDOW_SIZE])tcn_in);
 464:Src/main.c    ****   SCB_CleanDCache_by_Addr(tcn_in, STAI_TCN_NETWORK_IN_1_SIZE_BYTES);
 465:Src/main.c    **** 
 466:Src/main.c    ****   uint32_t t0 = HAL_GetTick();
 467:Src/main.c    ****   printf("[TCN] start\r\n");
 468:Src/main.c    ****   Run_TcnInference(tcn_network_context);
 469:Src/main.c    ****   uint32_t t1 = HAL_GetTick();
 470:Src/main.c    ****   fall_state.tcn_inference_ms = t1 - t0;
 471:Src/main.c    ****   printf("[TCN] done %lums\r\n", fall_state.tcn_inference_ms);
 472:Src/main.c    **** 
 473:Src/main.c    ****   SCB_InvalidateDCache_by_Addr(tcn_out[0], tcn_out_len[0]);
 474:Src/main.c    **** 
 475:Src/main.c    ****   float32_t *logits = (float32_t *)tcn_out[0];
 476:Src/main.c    ****   fall_state.normal_logit = logits[0];
 477:Src/main.c    ****   fall_state.fall_logit = logits[1];
 478:Src/main.c    **** 
 479:Src/main.c    ****   float32_t max_logit = (logits[0] > logits[1]) ? logits[0] : logits[1];
 480:Src/main.c    ****   float32_t normal_exp = expf(logits[0] - max_logit);
 481:Src/main.c    ****   float32_t fall_exp = expf(logits[1] - max_logit);
 482:Src/main.c    ****   float32_t denom = normal_exp + fall_exp;
 483:Src/main.c    **** 
 484:Src/main.c    ****   if (denom > 0.0f)
 485:Src/main.c    ****   {
 486:Src/main.c    ****     fall_state.normal_score = normal_exp / denom;
 487:Src/main.c    ****     fall_state.fall_score = fall_exp / denom;
 488:Src/main.c    ****   }
 489:Src/main.c    ****   else
 490:Src/main.c    ****   {
 491:Src/main.c    ****     fall_state.normal_score = 0.5f;
 492:Src/main.c    ****     fall_state.fall_score = 0.5f;
 493:Src/main.c    ****   }
 494:Src/main.c    **** 
 495:Src/main.c    ****   fall_state.fall_detected = (fall_state.fall_score >= fall_state.normal_score) ? 1u : 0u;
 496:Src/main.c    **** }
