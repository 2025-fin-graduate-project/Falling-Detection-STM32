1080:Src/main.c    ****     /* Robust Presence: Top-5 Average Confidence. 
1081:Src/main.c    ****      * If at least 5 keypoints are detected with some confidence, 
1082:Src/main.c    ****      * their average must be above threshold. */
1083:Src/main.c    ****     for (int i = 0; i < 5; i++)
1084:Src/main.c    ****     {
1085:Src/main.c    ****       for (int j = i + 1; j < POSE_KP_COUNT; j++)
1086:Src/main.c    ****       {
1087:Src/main.c    ****         if (scores[j] > scores[i])
1088:Src/main.c    ****         {
1089:Src/main.c    ****           float32_t tmp = scores[i];
1090:Src/main.c    ****           scores[i] = scores[j];
1091:Src/main.c    ****           scores[j] = tmp;
1092:Src/main.c    ****         }
1093:Src/main.c    ****       }
1094:Src/main.c    ****     }
1095:Src/main.c    **** 
1096:Src/main.c    ****     float32_t top5_avg = (scores[0] + scores[1] + scores[2] + scores[3] + scores[4]) / 5.0f;
1097:Src/main.c    **** 
1098:Src/main.c    ****     /* Presence: top-5 average confidence must be >= 0.2 */
1099:Src/main.c    ****     pose_debug_metrics.person_present = (top5_avg >= 0.2f) ? 1u : 0u;
1100:Src/main.c    **** 
1101:Src/main.c    ****     /* Keypoint spread: bounding box of confident keypoints (normalized 0-1).
1102:Src/main.c    ****      * Too large a span means noisy/scattered detections — skip visualization. */
1103:Src/main.c    ****     float32_t x_min = 1.0f, x_max = 0.0f;
1104:Src/main.c    ****     float32_t y_min = 1.0f, y_max = 0.0f;
1105:Src/main.c    ****     uint32_t n_spread = 0u;
1106:Src/main.c    ****     for (uint32_t i = 0; i < POSE_KP_COUNT; i++)
1107:Src/main.c    ****     {
1108:Src/main.c    ****       if (p_postprocess->pOutBuff[i].proba >= AI_POSE_PP_CONF_THRESHOLD)
1109:Src/main.c    ****       {
1110:Src/main.c    ****         float32_t x = p_postprocess->pOutBuff[i].x_center;
1111:Src/main.c    ****         float32_t y = p_postprocess->pOutBuff[i].y_center;
1112:Src/main.c    ****         if (x < x_min) x_min = x;
1113:Src/main.c    ****         if (x > x_max) x_max = x;
1114:Src/main.c    ****         if (y < y_min) y_min = y;
1115:Src/main.c    ****         if (y > y_max) y_max = y;
