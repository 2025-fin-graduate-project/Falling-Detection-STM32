 325:Src/main.c    **** static void Run_Inference(stai_network *network_instance) {
 326:Src/main.c    ****   stai_return_code ret;
 327:Src/main.c    **** 
 328:Src/main.c    ****   do {
 329:Src/main.c    ****     ret = stai_network_run(network_instance, STAI_MODE_ASYNC);
 330:Src/main.c    ****     if (ret == STAI_RUNNING_WFE)
 331:Src/main.c    ****       LL_ATON_OSAL_WFE();
 332:Src/main.c    ****   } while (ret == STAI_RUNNING_WFE || ret == STAI_RUNNING_NO_WFE);
 333:Src/main.c    **** 
 334:Src/main.c    ****   ret = stai_ext_network_new_inference(network_instance);
 335:Src/main.c    ****   assert(ret == STAI_SUCCESS);
 336:Src/main.c    **** }
