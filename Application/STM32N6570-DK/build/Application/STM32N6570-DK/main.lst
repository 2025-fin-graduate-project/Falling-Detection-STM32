 447:Src/main.c    **** static void FallDetection_Update(PosePipeline_t *pipeline)
 448:Src/main.c    **** {
 449:Src/main.c    ****   fall_state.frame_count = pipeline->win_count;
 450:Src/main.c    ****   fall_state.window_ready = PosePipeline_WindowFull(pipeline);
 451:Src/main.c    **** 
 452:Src/main.c    ****   if (!fall_state.window_ready)
 453:Src/main.c    ****   {
 454:Src/main.c    ****     fall_state.fall_detected = 0;
ARM GAS  /tmp/ccugGi0e.s 			page 48


 455:Src/main.c    ****     fall_state.fall_score = 0.0f;
 456:Src/main.c    ****     fall_state.normal_score = 0.0f;
 457:Src/main.c    ****     fall_state.tcn_inference_ms = 0;
 458:Src/main.c    ****     return;
 459:Src/main.c    ****   }
 460:Src/main.c    **** 
 461:Src/main.c    ****   PosePipeline_GetWindowFeaturesFirst(pipeline, (float32_t (*)[POSE_WINDOW_SIZE])tcn_in);
 462:Src/main.c    ****   SCB_CleanDCache_by_Addr(tcn_in, STAI_TCN_NETWORK_IN_1_SIZE_BYTES);
 463:Src/main.c    **** 
 464:Src/main.c    ****   uint32_t t0 = HAL_GetTick();
 465:Src/main.c    ****   printf("[TCN] start\r\n");
 466:Src/main.c    ****   Run_TcnInference(tcn_network_context);
 467:Src/main.c    ****   uint32_t t1 = HAL_GetTick();
 468:Src/main.c    ****   fall_state.tcn_inference_ms = t1 - t0;
 469:Src/main.c    ****   printf("[TCN] done %lums\r\n", fall_state.tcn_inference_ms);
 470:Src/main.c    **** 
 471:Src/main.c    ****   SCB_InvalidateDCache_by_Addr(tcn_out[0], tcn_out_len[0]);
 472:Src/main.c    **** 
 473:Src/main.c    ****   float32_t *logits = (float32_t *)tcn_out[0];
 474:Src/main.c    ****   fall_state.normal_logit = logits[0];
 475:Src/main.c    ****   fall_state.fall_logit = logits[1];
 476:Src/main.c    **** 
 477:Src/main.c    ****   float32_t max_logit = (logits[0] > logits[1]) ? logits[0] : logits[1];
 478:Src/main.c    ****   float32_t normal_exp = expf(logits[0] - max_logit);
 479:Src/main.c    ****   float32_t fall_exp = expf(logits[1] - max_logit);
 480:Src/main.c    ****   float32_t denom = normal_exp + fall_exp;
 481:Src/main.c    **** 
 482:Src/main.c    ****   if (denom > 0.0f)
 483:Src/main.c    ****   {
 484:Src/main.c    ****     fall_state.normal_score = normal_exp / denom;
 485:Src/main.c    ****     fall_state.fall_score = fall_exp / denom;
 486:Src/main.c    ****   }
 487:Src/main.c    ****   else
 488:Src/main.c    ****   {
 489:Src/main.c    ****     fall_state.normal_score = 0.5f;
 490:Src/main.c    ****     fall_state.fall_score = 0.5f;
 491:Src/main.c    ****   }
 492:Src/main.c    **** 
 493:Src/main.c    ****   fall_state.fall_detected = (fall_state.fall_score >= fall_state.normal_score) ? 1u : 0u;
 494:Src/main.c    **** }
