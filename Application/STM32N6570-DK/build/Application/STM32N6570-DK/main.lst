 472:Src/main.c    ****     if (HAL_XSPI_GET_FLAG(&hxspi_nor[0], HAL_XSPI_FLAG_BUSY))
 473:Src/main.c    ****     {
 474:Src/main.c    ****       SET_BIT(hxspi_nor[0].Instance->CR, XSPI_CR_ABORT);
 475:Src/main.c    ****       uint32_t t0 = HAL_GetTick();
 476:Src/main.c    ****       while (!HAL_XSPI_GET_FLAG(&hxspi_nor[0], HAL_XSPI_FLAG_TC) &&
 477:Src/main.c    ****              (HAL_GetTick() - t0) < 100U) {}
 478:Src/main.c    ****       HAL_XSPI_CLEAR_FLAG(&hxspi_nor[0], HAL_XSPI_FLAG_TC);
 479:Src/main.c    ****       t0 = HAL_GetTick();
 480:Src/main.c    ****       while (HAL_XSPI_GET_FLAG(&hxspi_nor[0], HAL_XSPI_FLAG_BUSY) &&
 481:Src/main.c    ****              (HAL_GetTick() - t0) < 100U) {}
 482:Src/main.c    ****     }
 483:Src/main.c    ****     hxspi_nor[0].State = HAL_XSPI_STATE_READY;
 484:Src/main.c    ****   }
 485:Src/main.c    ****   BSP_XSPI_NOR_EnableMemoryMappedMode(0);
 486:Src/main.c    **** 
 487:Src/main.c    ****   ret = stai_gru_network_run(gru_network_context, STAI_MODE_SYNC);
 488:Src/main.c    **** #else
 489:Src/main.c    ****   do {
 490:Src/main.c    ****     ret = stai_tcn_network_run(tcn_network_context, STAI_MODE_ASYNC);
