1116:Src/main.c    ****         n_spread++;
1117:Src/main.c    ****       }
1118:Src/main.c    ****     }
1119:Src/main.c    ****     if (n_spread >= 2u)
1120:Src/main.c    ****     {
1121:Src/main.c    ****       float32_t span_x = x_max - x_min;
1122:Src/main.c    ****       float32_t span_y = y_max - y_min;
1123:Src/main.c    ****       pose_debug_metrics.keypoints_too_spread =
1124:Src/main.c    ****         ((span_x > FALL_KP_SPREAD_MAX) || (span_y > FALL_KP_SPREAD_MAX)) ? 1u : 0u;
1125:Src/main.c    ****     }
1126:Src/main.c    ****     else
