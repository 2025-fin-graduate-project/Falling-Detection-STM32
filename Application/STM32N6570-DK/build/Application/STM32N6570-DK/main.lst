 480:Src/main.c    ****       t0 = HAL_GetTick();
 481:Src/main.c    ****       while (HAL_XSPI_GET_FLAG(&hxspi_nor[0], HAL_XSPI_FLAG_BUSY) &&
 482:Src/main.c    ****              (HAL_GetTick() - t0) < 100U) {}
 483:Src/main.c    ****     }
 484:Src/main.c    ****     hxspi_nor[0].State = HAL_XSPI_STATE_READY;
 485:Src/main.c    ****   }
