1035:Src/main.c    ****       }
1036:Src/main.c    ****     }
1037:Src/main.c    **** 
1038:Src/main.c    ****     float32_t top5_avg = (scores[0] + scores[1] + scores[2] + scores[3] + scores[4]) / 5.0f;
1039:Src/main.c    **** 
1040:Src/main.c    ****     /* Presence: top-5 average confidence must be >= 0.2 */
