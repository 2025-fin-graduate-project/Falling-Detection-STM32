  34:Src/pose_pipeline.c **** /** 2-D Euclidean distance (normalised coordinates). */
  35:Src/pose_pipeline.c **** static inline float32_t kp_dist(float32_t x0, float32_t y0,
  36:Src/pose_pipeline.c ****                                  float32_t x1, float32_t y1)
  37:Src/pose_pipeline.c **** {
  38:Src/pose_pipeline.c ****     float32_t dx = x1 - x0;
  39:Src/pose_pipeline.c ****     float32_t dy = y1 - y0;
  40:Src/pose_pipeline.c ****     return sqrtf(dx * dx + dy * dy);
  41:Src/pose_pipeline.c **** }
  42:Src/pose_pipeline.c **** 
  43:Src/pose_pipeline.c **** /**
  44:Src/pose_pipeline.c ****  * Compute torso length from shoulder and hip keypoints.
  45:Src/pose_pipeline.c ****  * Uses average of two cross-diagonal distances (left_shoulder↔right_hip,
  46:Src/pose_pipeline.c ****  * right_shoulder↔left_hip) for robustness.
  47:Src/pose_pipeline.c ****  * Falls back to a fixed fraction of the image diagonal if keypoints are
  48:Src/pose_pipeline.c ****  * unavailable.
  49:Src/pose_pipeline.c ****  */
  50:Src/pose_pipeline.c **** static float32_t compute_torso_length(const spe_pp_outBuffer_t *kp)
  51:Src/pose_pipeline.c **** {
  52:Src/pose_pipeline.c ****     float32_t len = 0.0f;
  53:Src/pose_pipeline.c ****     uint32_t n = 0;
  54:Src/pose_pipeline.c **** 
  55:Src/pose_pipeline.c ****     /* cross-diagonal 1: left_shoulder (5) → right_hip (12) */
  56:Src/pose_pipeline.c ****     if (kp[POSE_KP_LEFT_SHOULDER].proba  >= POSE_OUTLIER_LOW_THRESH &&
  57:Src/pose_pipeline.c ****         kp[POSE_KP_RIGHT_HIP].proba      >= POSE_OUTLIER_LOW_THRESH)
  58:Src/pose_pipeline.c ****     {
  59:Src/pose_pipeline.c ****         len += kp_dist(kp[POSE_KP_LEFT_SHOULDER].x_center,
  60:Src/pose_pipeline.c ****                        kp[POSE_KP_LEFT_SHOULDER].y_center,
  61:Src/pose_pipeline.c ****                        kp[POSE_KP_RIGHT_HIP].x_center,
  62:Src/pose_pipeline.c ****                        kp[POSE_KP_RIGHT_HIP].y_center);
  63:Src/pose_pipeline.c ****         n++;
  64:Src/pose_pipeline.c ****     }
  65:Src/pose_pipeline.c ****     /* cross-diagonal 2: right_shoulder (6) → left_hip (11) */
  66:Src/pose_pipeline.c ****     if (kp[POSE_KP_RIGHT_SHOULDER].proba >= POSE_OUTLIER_LOW_THRESH &&
  67:Src/pose_pipeline.c ****         kp[POSE_KP_LEFT_HIP].proba       >= POSE_OUTLIER_LOW_THRESH)
  68:Src/pose_pipeline.c ****     {
  69:Src/pose_pipeline.c ****         len += kp_dist(kp[POSE_KP_RIGHT_SHOULDER].x_center,
  70:Src/pose_pipeline.c ****                        kp[POSE_KP_RIGHT_SHOULDER].y_center,
  71:Src/pose_pipeline.c ****                        kp[POSE_KP_LEFT_HIP].x_center,
  72:Src/pose_pipeline.c ****                        kp[POSE_KP_LEFT_HIP].y_center);
  73:Src/pose_pipeline.c ****         n++;
  74:Src/pose_pipeline.c ****     }
  75:Src/pose_pipeline.c **** 
  76:Src/pose_pipeline.c ****     if (n > 0)
  77:Src/pose_pipeline.c ****         return len / (float32_t)n;
  78:Src/pose_pipeline.c **** 
  79:Src/pose_pipeline.c ****     /* Fallback: ~10% of normalised diagonal */
  80:Src/pose_pipeline.c ****     return 0.10f;
  81:Src/pose_pipeline.c **** }
