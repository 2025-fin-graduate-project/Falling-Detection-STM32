 194:Src/pose_pipeline.c **** /**
ARM GAS  /tmp/ccyXk24x.s 			page 6


 195:Src/pose_pipeline.c ****  * Compute the 1-Euro low-pass filter alpha coefficient.
 196:Src/pose_pipeline.c ****  *
 197:Src/pose_pipeline.c ****  * alpha = (2*pi*cutoff*dt) / (2*pi*cutoff*dt + 1)
 198:Src/pose_pipeline.c ****  */
 199:Src/pose_pipeline.c **** static inline float32_t euro_alpha(float32_t cutoff, float32_t dt)
 200:Src/pose_pipeline.c **** {
 201:Src/pose_pipeline.c ****     float32_t tau = 1.0f / (2.0f * (float32_t)M_PI * cutoff);
 202:Src/pose_pipeline.c ****     return dt / (dt + tau);
 203:Src/pose_pipeline.c **** }
 204:Src/pose_pipeline.c **** 
 205:Src/pose_pipeline.c **** /**
 206:Src/pose_pipeline.c ****  * Run one 1-Euro filter step for a single keypoint.
 207:Src/pose_pipeline.c ****  *
 208:Src/pose_pipeline.c ****  * @param st      Filter state (updated).
 209:Src/pose_pipeline.c ****  * @param x_raw   Outlier-rejected x input.
 210:Src/pose_pipeline.c ****  * @param y_raw   Outlier-rejected y input.
 211:Src/pose_pipeline.c ****  * @param dt      Time step in seconds.
 212:Src/pose_pipeline.c ****  * @param out_x   Filtered x.
 213:Src/pose_pipeline.c ****  * @param out_y   Filtered y.
 214:Src/pose_pipeline.c ****  */
 215:Src/pose_pipeline.c **** static void euro_process(EuroKP_t *st,
 216:Src/pose_pipeline.c ****                           float32_t x_raw, float32_t y_raw,
 217:Src/pose_pipeline.c ****                           float32_t dt,
 218:Src/pose_pipeline.c ****                           float32_t *out_x, float32_t *out_y)
 219:Src/pose_pipeline.c **** {
 220:Src/pose_pipeline.c ****     if (!st->initialized)
 221:Src/pose_pipeline.c ****     {
 222:Src/pose_pipeline.c ****         st->x_hat  = x_raw;
 223:Src/pose_pipeline.c ****         st->y_hat  = y_raw;
 224:Src/pose_pipeline.c ****         st->dx_hat = 0.0f;
 225:Src/pose_pipeline.c ****         st->dy_hat = 0.0f;
 226:Src/pose_pipeline.c ****         st->initialized = 1;
 227:Src/pose_pipeline.c ****         *out_x = x_raw;
 228:Src/pose_pipeline.c ****         *out_y = y_raw;
 229:Src/pose_pipeline.c ****         return;
 230:Src/pose_pipeline.c ****     }
 231:Src/pose_pipeline.c **** 
 232:Src/pose_pipeline.c ****     /* Clamp dt to a reasonable range to avoid instability */
 233:Src/pose_pipeline.c ****     if (dt < 1e-6f) dt = 1e-6f;
 234:Src/pose_pipeline.c ****     if (dt > 1.0f)  dt = 1.0f;
 235:Src/pose_pipeline.c **** 
 236:Src/pose_pipeline.c ****     /* --- Derivative filter ---------------------------------------- */
 237:Src/pose_pipeline.c ****     float32_t a_d = euro_alpha(POSE_EURO_D_CUTOFF, dt);
 238:Src/pose_pipeline.c **** 
 239:Src/pose_pipeline.c ****     float32_t dx_raw = (x_raw - st->x_hat) / dt;
 240:Src/pose_pipeline.c ****     float32_t dy_raw = (y_raw - st->y_hat) / dt;
 241:Src/pose_pipeline.c **** 
 242:Src/pose_pipeline.c ****     float32_t dx_hat = a_d * dx_raw + (1.0f - a_d) * st->dx_hat;
 243:Src/pose_pipeline.c ****     float32_t dy_hat = a_d * dy_raw + (1.0f - a_d) * st->dy_hat;
 244:Src/pose_pipeline.c **** 
 245:Src/pose_pipeline.c ****     st->dx_hat = dx_hat;
 246:Src/pose_pipeline.c ****     st->dy_hat = dy_hat;
 247:Src/pose_pipeline.c **** 
 248:Src/pose_pipeline.c ****     /* --- Signal filter  ------------------------------------------- */
 249:Src/pose_pipeline.c ****     float32_t speed = sqrtf(dx_hat * dx_hat + dy_hat * dy_hat);
 250:Src/pose_pipeline.c **** 
 251:Src/pose_pipeline.c ****     float32_t cutoff_x = POSE_EURO_MIN_CUTOFF + POSE_EURO_BETA * fabsf(dx_hat);
ARM GAS  /tmp/ccyXk24x.s 			page 7


 252:Src/pose_pipeline.c ****     float32_t cutoff_y = POSE_EURO_MIN_CUTOFF + POSE_EURO_BETA * fabsf(dy_hat);
 253:Src/pose_pipeline.c ****     (void)speed; /* retained for documentation; individual cutoffs used */
 254:Src/pose_pipeline.c **** 
 255:Src/pose_pipeline.c ****     float32_t a_x = euro_alpha(cutoff_x, dt);
 256:Src/pose_pipeline.c ****     float32_t a_y = euro_alpha(cutoff_y, dt);
 257:Src/pose_pipeline.c **** 
 258:Src/pose_pipeline.c ****     st->x_hat = a_x * x_raw + (1.0f - a_x) * st->x_hat;
 259:Src/pose_pipeline.c ****     st->y_hat = a_y * y_raw + (1.0f - a_y) * st->y_hat;
 260:Src/pose_pipeline.c **** 
 261:Src/pose_pipeline.c ****     *out_x = st->x_hat;
 262:Src/pose_pipeline.c ****     *out_y = st->y_hat;
 263:Src/pose_pipeline.c **** }
