 124:Src/pose_pipeline.c **** 
 125:Src/pose_pipeline.c **** static float32_t compute_rwhc(const float32_t all_kp[POSE_KP_COUNT * 3u])
 126:Src/pose_pipeline.c **** {
 127:Src/pose_pipeline.c ****     float32_t min_x = all_kp[1u], max_x = all_kp[1u];
 128:Src/pose_pipeline.c ****     float32_t min_y = all_kp[0u], max_y = all_kp[0u];
 129:Src/pose_pipeline.c ****     for (uint32_t i = 1u; i < POSE_KP_COUNT; i++)
 130:Src/pose_pipeline.c ****     {
 131:Src/pose_pipeline.c ****         float32_t y = all_kp[i * 3u + 0u];
 132:Src/pose_pipeline.c ****         float32_t x = all_kp[i * 3u + 1u];
 133:Src/pose_pipeline.c ****         if (x < min_x) min_x = x;
 134:Src/pose_pipeline.c ****         if (x > max_x) max_x = x;
 135:Src/pose_pipeline.c ****         if (y < min_y) min_y = y;
 136:Src/pose_pipeline.c ****         if (y > max_y) max_y = y;
 137:Src/pose_pipeline.c ****     }
 138:Src/pose_pipeline.c ****     float32_t height = max_y - min_y;
 139:Src/pose_pipeline.c ****     if (height <= 0.0f) height = 0.001f;
 140:Src/pose_pipeline.c ****     return (max_x - min_x) / height;
 141:Src/pose_pipeline.c **** }
