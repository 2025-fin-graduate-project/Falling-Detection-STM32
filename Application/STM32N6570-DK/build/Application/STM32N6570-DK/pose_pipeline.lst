 113:Src/pose_pipeline.c **** 
 114:Src/pose_pipeline.c ****     if (x < min_x)
 115:Src/pose_pipeline.c ****     {
 116:Src/pose_pipeline.c ****       min_x = x;
 117:Src/pose_pipeline.c ****     }
 118:Src/pose_pipeline.c ****     if (x > max_x)
