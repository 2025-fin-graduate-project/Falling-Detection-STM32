 102:Src/pose_pipeline.c **** static float32_t compute_rwhc(const float32_t features[POSE_FEATURE_COUNT])
 103:Src/pose_pipeline.c **** {
 104:Src/pose_pipeline.c ****   float32_t min_x = features[1];
 105:Src/pose_pipeline.c ****   float32_t max_x = features[1];
 106:Src/pose_pipeline.c ****   float32_t min_y = features[0];
 107:Src/pose_pipeline.c ****   float32_t max_y = features[0];
 108:Src/pose_pipeline.c **** 
