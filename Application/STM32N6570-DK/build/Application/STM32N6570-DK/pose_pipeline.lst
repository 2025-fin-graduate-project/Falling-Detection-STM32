 118:Src/pose_pipeline.c ****         sum_y += all_kp[idx * 3u + 0u];
 119:Src/pose_pipeline.c ****         sum_x += all_kp[idx * 3u + 1u];
 120:Src/pose_pipeline.c ****     }
