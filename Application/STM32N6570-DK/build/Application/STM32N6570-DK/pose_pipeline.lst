  55:Src/pose_pipeline.c **** /**
  56:Src/pose_pipeline.c ****  * Compute torso length as in preprocessing_pipeline.ipynb Step 2:
  57:Src/pose_pipeline.c ****  * distance between shoulder midpoint and hip midpoint.
  58:Src/pose_pipeline.c ****  */
  59:Src/pose_pipeline.c **** static float32_t compute_torso_length(const spe_pp_outBuffer_t *kp, float32_t previous)
  60:Src/pose_pipeline.c **** {
  61:Src/pose_pipeline.c ****     if ((kp[POSE_KP_LEFT_SHOULDER].proba  >= POSE_OUTLIER_HIGH_THRESH) &&
  62:Src/pose_pipeline.c ****         (kp[POSE_KP_RIGHT_SHOULDER].proba >= POSE_OUTLIER_HIGH_THRESH) &&
  63:Src/pose_pipeline.c ****         (kp[POSE_KP_LEFT_HIP].proba       >= POSE_OUTLIER_HIGH_THRESH) &&
  64:Src/pose_pipeline.c ****         (kp[POSE_KP_RIGHT_HIP].proba      >= POSE_OUTLIER_HIGH_THRESH))
  65:Src/pose_pipeline.c ****     {
  66:Src/pose_pipeline.c ****         float32_t shoulder_x = (kp[POSE_KP_LEFT_SHOULDER].x_center + kp[POSE_KP_RIGHT_SHOULDER].x_c
  67:Src/pose_pipeline.c ****         float32_t shoulder_y = (kp[POSE_KP_LEFT_SHOULDER].y_center + kp[POSE_KP_RIGHT_SHOULDER].y_c
  68:Src/pose_pipeline.c ****         float32_t hip_x = (kp[POSE_KP_LEFT_HIP].x_center + kp[POSE_KP_RIGHT_HIP].x_center) * 0.5f;
  69:Src/pose_pipeline.c ****         float32_t hip_y = (kp[POSE_KP_LEFT_HIP].y_center + kp[POSE_KP_RIGHT_HIP].y_center) * 0.5f;
  70:Src/pose_pipeline.c ****         float32_t len = kp_dist(shoulder_x, shoulder_y, hip_x, hip_y);
  71:Src/pose_pipeline.c ****         return (len > 0.05f) ? len : 0.05f;
  72:Src/pose_pipeline.c ****     }
  73:Src/pose_pipeline.c **** 
  74:Src/pose_pipeline.c ****     return (previous > 0.0f) ? previous : 0.20f;
  75:Src/pose_pipeline.c **** }
  76:Src/pose_pipeline.c **** 
