 365:Src/pose_pipeline.c ****                      filt_x[i], filt_y[i],
 366:Src/pose_pipeline.c ****                      dt,
 367:Src/pose_pipeline.c ****                      &smooth_x[i], &smooth_y[i]);
 368:Src/pose_pipeline.c ****     }
 369:Src/pose_pipeline.c **** 
 370:Src/pose_pipeline.c ****     /* --- Step 4: Feature extraction ------------------------------- */
 371:Src/pose_pipeline.c **** 
 372:Src/pose_pipeline.c ****     /* HSSC */
 373:Src/pose_pipeline.c ****     float32_t hssc_x, hssc_y;
 374:Src/pose_pipeline.c ****     compute_hssc(smooth_x, smooth_y, filt_p, &hssc_x, &hssc_y);
 375:Src/pose_pipeline.c **** 
 376:Src/pose_pipeline.c ****     /* VHSSC = d(HSSC_Y)/dt */
 377:Src/pose_pipeline.c ****     float32_t vhssc = 0.0f;
 378:Src/pose_pipeline.c ****     float32_t ahssc = 0.0f;
 379:Src/pose_pipeline.c **** 
 380:Src/pose_pipeline.c ****     if (s->deriv_initialized && dt > 1e-6f)
 381:Src/pose_pipeline.c ****     {
 382:Src/pose_pipeline.c ****         vhssc = (hssc_y - s->hssc_y_prev) / dt;
 383:Src/pose_pipeline.c ****         ahssc = (vhssc - s->vhssc_prev)   / dt;
 384:Src/pose_pipeline.c ****     }
 385:Src/pose_pipeline.c **** 
 386:Src/pose_pipeline.c ****     s->hssc_y_prev       = hssc_y;
 387:Src/pose_pipeline.c ****     s->vhssc_prev        = vhssc;
 388:Src/pose_pipeline.c ****     s->deriv_initialized = 1;
 389:Src/pose_pipeline.c **** 
 390:Src/pose_pipeline.c ****     /* --- Assemble 55-feature vector ------------------------------- */
 391:Src/pose_pipeline.c ****     /*     Layout: [y0,x0,s0, y1,x1,s1, ..., y16,x16,s16,             */
 392:Src/pose_pipeline.c ****     /*              HSSC_X, HSSC_Y, VHSSC, AHSSC]                      */
 393:Src/pose_pipeline.c ****     float32_t features[POSE_FEATURE_COUNT];
 394:Src/pose_pipeline.c ****     for (uint32_t i = 0; i < POSE_KP_COUNT; i++)
 395:Src/pose_pipeline.c ****     {
 396:Src/pose_pipeline.c ****         features[i * 3 + 0] = smooth_y[i];   /* y first (matches notebook) */
 397:Src/pose_pipeline.c ****         features[i * 3 + 1] = smooth_x[i];
 398:Src/pose_pipeline.c ****         features[i * 3 + 2] = filt_p[i];
 399:Src/pose_pipeline.c ****     }
 400:Src/pose_pipeline.c ****     features[POSE_KP_COUNT * 3 + 0] = hssc_x;
 401:Src/pose_pipeline.c ****     features[POSE_KP_COUNT * 3 + 1] = hssc_y;
