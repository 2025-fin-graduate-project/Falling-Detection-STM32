 253:Src/pose_pipeline.c **** /* Step 4 – Feature extraction                                          */
 254:Src/pose_pipeline.c **** /* ------------------------------------------------------------------ */
 255:Src/pose_pipeline.c **** 
 256:Src/pose_pipeline.c **** /* Upper-body keypoint indices for HSSC */
 257:Src/pose_pipeline.c **** static const uint8_t hssc_indices[POSE_HSSC_INDICES_COUNT] = {
 258:Src/pose_pipeline.c ****     POSE_KP_NOSE,
 259:Src/pose_pipeline.c ****     POSE_KP_LEFT_EYE, POSE_KP_RIGHT_EYE,
 260:Src/pose_pipeline.c ****     POSE_KP_LEFT_EAR, POSE_KP_RIGHT_EAR,
 261:Src/pose_pipeline.c ****     POSE_KP_LEFT_SHOULDER, POSE_KP_RIGHT_SHOULDER
 262:Src/pose_pipeline.c **** };
 263:Src/pose_pipeline.c **** 
 264:Src/pose_pipeline.c **** /**
 265:Src/pose_pipeline.c ****  * Compute upper-body horizontal/vertical centre of mass (HSSC).
 266:Src/pose_pipeline.c ****  *
 267:Src/pose_pipeline.c ****  * Each contributing keypoint is weighted by its confidence score.
 268:Src/pose_pipeline.c ****  * If no keypoint has positive confidence, the centre defaults to 0.5.
 269:Src/pose_pipeline.c ****  *
 270:Src/pose_pipeline.c ****  * @param filt_x   Filtered x positions [POSE_KP_COUNT].
 271:Src/pose_pipeline.c ****  * @param filt_y   Filtered y positions [POSE_KP_COUNT].
 272:Src/pose_pipeline.c ****  * @param filt_p   Filtered confidence  [POSE_KP_COUNT].
 273:Src/pose_pipeline.c ****  * @param hssc_x   Output: horizontal centre of mass.
 274:Src/pose_pipeline.c ****  * @param hssc_y   Output: vertical centre of mass.
 275:Src/pose_pipeline.c ****  */
 276:Src/pose_pipeline.c **** static void compute_hssc(const float32_t filt_x[POSE_KP_COUNT],
 277:Src/pose_pipeline.c ****                           const float32_t filt_y[POSE_KP_COUNT],
 278:Src/pose_pipeline.c ****                           const float32_t filt_p[POSE_KP_COUNT],
 279:Src/pose_pipeline.c ****                           float32_t *hssc_x,
 280:Src/pose_pipeline.c ****                           float32_t *hssc_y)
 281:Src/pose_pipeline.c **** {
 282:Src/pose_pipeline.c ****     float32_t sum_wx = 0.0f;
 283:Src/pose_pipeline.c ****     float32_t sum_wy = 0.0f;
 284:Src/pose_pipeline.c ****     float32_t sum_w  = 0.0f;
 285:Src/pose_pipeline.c **** 
 286:Src/pose_pipeline.c ****     for (uint32_t i = 0; i < POSE_HSSC_INDICES_COUNT; i++)
 287:Src/pose_pipeline.c ****     {
 288:Src/pose_pipeline.c ****         uint8_t idx = hssc_indices[i];
 289:Src/pose_pipeline.c ****         float32_t w = filt_p[idx];
 290:Src/pose_pipeline.c ****         if (w > 0.0f)
 291:Src/pose_pipeline.c ****         {
 292:Src/pose_pipeline.c ****             sum_wx += w * filt_x[idx];
 293:Src/pose_pipeline.c ****             sum_wy += w * filt_y[idx];
 294:Src/pose_pipeline.c ****             sum_w  += w;
 295:Src/pose_pipeline.c ****         }
 296:Src/pose_pipeline.c ****     }
 297:Src/pose_pipeline.c **** 
 298:Src/pose_pipeline.c ****     if (sum_w > 0.0f)
 299:Src/pose_pipeline.c ****     {
 300:Src/pose_pipeline.c ****         *hssc_x = sum_wx / sum_w;
 301:Src/pose_pipeline.c ****         *hssc_y = sum_wy / sum_w;
 302:Src/pose_pipeline.c ****     }
 303:Src/pose_pipeline.c ****     else
 304:Src/pose_pipeline.c ****     {
 305:Src/pose_pipeline.c ****         *hssc_x = 0.5f;
 306:Src/pose_pipeline.c ****         *hssc_y = 0.5f;
 307:Src/pose_pipeline.c ****     }
 308:Src/pose_pipeline.c **** }
 309:Src/pose_pipeline.c **** 
