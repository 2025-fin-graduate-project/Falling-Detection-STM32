 402:Src/pose_pipeline.c ****     features[POSE_KP_COUNT * 3 + 2] = vhssc;
 403:Src/pose_pipeline.c ****     features[POSE_KP_COUNT * 3 + 3] = ahssc;
 404:Src/pose_pipeline.c **** 
 405:Src/pose_pipeline.c ****     /* --- Copy to caller output ------------------------------------ */
 406:Src/pose_pipeline.c ****     if (out != NULL)
 407:Src/pose_pipeline.c ****     {
 408:Src/pose_pipeline.c ****         memcpy(out->f, features, sizeof(features));
