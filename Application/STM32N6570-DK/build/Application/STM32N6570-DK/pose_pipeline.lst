 106:Src/pose_pipeline.c **** /* Velocity source indices into the 45-feat base array.
 107:Src/pose_pipeline.c ****  * Matches KP13_VEL_BASE = columns ending in _y or _x from KP13_COLS.
 108:Src/pose_pipeline.c ****  * Order: kp0_y,kp0_x, kp5_y,kp5_x, ..., kp16_y,kp16_x, HSSC_y, HSSC_x, AHSSC_x */
