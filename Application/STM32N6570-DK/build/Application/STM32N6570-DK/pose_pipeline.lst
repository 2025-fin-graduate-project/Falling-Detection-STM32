 359:Src/pose_pipeline.c ****     float32_t smooth_x[POSE_KP_COUNT];
 360:Src/pose_pipeline.c ****     float32_t smooth_y[POSE_KP_COUNT];
 361:Src/pose_pipeline.c **** 
