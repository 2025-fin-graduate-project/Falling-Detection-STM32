 410:Src/pose_pipeline.c ****     }
 411:Src/pose_pipeline.c **** 
 412:Src/pose_pipeline.c ****     /* --- Step 5: Append to sliding window ------------------------- */
 413:Src/pose_pipeline.c ****     memcpy(s->win_buf[s->win_head], features, sizeof(features));
