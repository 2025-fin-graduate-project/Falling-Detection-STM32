 269:Src/pose_pipeline.c **** /* Upper-body keypoint indices for HSSC */
 270:Src/pose_pipeline.c **** static const uint8_t hssc_indices[POSE_HSSC_INDICES_COUNT] = {
 271:Src/pose_pipeline.c ****     POSE_KP_NOSE,
 272:Src/pose_pipeline.c ****     POSE_KP_LEFT_EYE, POSE_KP_RIGHT_EYE,
 273:Src/pose_pipeline.c ****     POSE_KP_LEFT_EAR, POSE_KP_RIGHT_EAR,
 274:Src/pose_pipeline.c ****     POSE_KP_LEFT_SHOULDER, POSE_KP_RIGHT_SHOULDER
 275:Src/pose_pipeline.c **** };
 276:Src/pose_pipeline.c **** 
 277:Src/pose_pipeline.c **** /**
 278:Src/pose_pipeline.c ****  * Compute upper-body horizontal/vertical centre of mass (HSSC).
 279:Src/pose_pipeline.c ****  *
 280:Src/pose_pipeline.c ****  * Each contributing keypoint is weighted by its confidence score.
 281:Src/pose_pipeline.c ****  * If no keypoint has positive confidence, the centre defaults to 0.5.
 282:Src/pose_pipeline.c ****  *
 283:Src/pose_pipeline.c ****  * @param filt_x   Filtered x positions [POSE_KP_COUNT].
 284:Src/pose_pipeline.c ****  * @param filt_y   Filtered y positions [POSE_KP_COUNT].
 285:Src/pose_pipeline.c ****  * @param filt_p   Filtered confidence  [POSE_KP_COUNT].
 286:Src/pose_pipeline.c ****  * @param hssc_x   Output: horizontal centre of mass.
 287:Src/pose_pipeline.c ****  * @param hssc_y   Output: vertical centre of mass.
 288:Src/pose_pipeline.c ****  */
 289:Src/pose_pipeline.c **** static void compute_hssc(const float32_t filt_x[POSE_KP_COUNT],
 290:Src/pose_pipeline.c ****                           const float32_t filt_y[POSE_KP_COUNT],
 291:Src/pose_pipeline.c ****                           const float32_t filt_p[POSE_KP_COUNT],
 292:Src/pose_pipeline.c ****                           float32_t *hssc_x,
 293:Src/pose_pipeline.c ****                           float32_t *hssc_y)
 294:Src/pose_pipeline.c **** {
 295:Src/pose_pipeline.c ****     float32_t sum_wx = 0.0f;
 296:Src/pose_pipeline.c ****     float32_t sum_wy = 0.0f;
 297:Src/pose_pipeline.c ****     float32_t sum_w  = 0.0f;
 298:Src/pose_pipeline.c **** 
 299:Src/pose_pipeline.c ****     for (uint32_t i = 0; i < POSE_HSSC_INDICES_COUNT; i++)
 300:Src/pose_pipeline.c ****     {
 301:Src/pose_pipeline.c ****         uint8_t idx = hssc_indices[i];
 302:Src/pose_pipeline.c ****         float32_t w = filt_p[idx];
 303:Src/pose_pipeline.c ****         if (w > 0.0f)
 304:Src/pose_pipeline.c ****         {
 305:Src/pose_pipeline.c ****             sum_wx += w * filt_x[idx];
 306:Src/pose_pipeline.c ****             sum_wy += w * filt_y[idx];
 307:Src/pose_pipeline.c ****             sum_w  += w;
 308:Src/pose_pipeline.c ****         }
ARM GAS  /tmp/ccyXk24x.s 			page 8


 309:Src/pose_pipeline.c ****     }
 310:Src/pose_pipeline.c **** 
 311:Src/pose_pipeline.c ****     if (sum_w > 0.0f)
 312:Src/pose_pipeline.c ****     {
 313:Src/pose_pipeline.c ****         *hssc_x = sum_wx / sum_w;
 314:Src/pose_pipeline.c ****         *hssc_y = sum_wy / sum_w;
 315:Src/pose_pipeline.c ****     }
 316:Src/pose_pipeline.c ****     else
 317:Src/pose_pipeline.c ****     {
 318:Src/pose_pipeline.c ****         *hssc_x = 0.5f;
 319:Src/pose_pipeline.c ****         *hssc_y = 0.5f;
 320:Src/pose_pipeline.c ****     }
 321:Src/pose_pipeline.c **** }
