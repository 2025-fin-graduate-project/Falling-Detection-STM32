 131:Src/pose_pipeline.c **** static void compute_hssc(const float32_t all_kp[POSE_KP_COUNT * 3u],
 132:Src/pose_pipeline.c ****                          float32_t *hssc_x, float32_t *hssc_y)
 133:Src/pose_pipeline.c **** {
 134:Src/pose_pipeline.c ****     float32_t sum_x = 0.0f;
 135:Src/pose_pipeline.c ****     float32_t sum_y = 0.0f;
 136:Src/pose_pipeline.c ****     for (uint32_t i = 0u; i < POSE_HSSC_INDICES_COUNT; i++)
 137:Src/pose_pipeline.c ****     {
 138:Src/pose_pipeline.c ****         uint32_t idx = hssc_indices[i];
 139:Src/pose_pipeline.c ****         sum_y += all_kp[idx * 3u + 0u];
 140:Src/pose_pipeline.c ****         sum_x += all_kp[idx * 3u + 1u];
 141:Src/pose_pipeline.c ****     }
 142:Src/pose_pipeline.c ****     *hssc_y = sum_y / (float32_t)POSE_HSSC_INDICES_COUNT;
 143:Src/pose_pipeline.c ****     *hssc_x = sum_x / (float32_t)POSE_HSSC_INDICES_COUNT;
 144:Src/pose_pipeline.c **** }
 145:Src/pose_pipeline.c **** 
 146:Src/pose_pipeline.c **** static float32_t compute_rwhc(const float32_t all_kp[POSE_KP_COUNT * 3u])
 147:Src/pose_pipeline.c **** {
 148:Src/pose_pipeline.c ****     float32_t min_x = all_kp[1u], max_x = all_kp[1u];
 149:Src/pose_pipeline.c ****     float32_t min_y = all_kp[0u], max_y = all_kp[0u];
 150:Src/pose_pipeline.c ****     for (uint32_t i = 1u; i < POSE_KP_COUNT; i++)
 151:Src/pose_pipeline.c ****     {
 152:Src/pose_pipeline.c ****         float32_t y = all_kp[i * 3u + 0u];
 153:Src/pose_pipeline.c ****         float32_t x = all_kp[i * 3u + 1u];
 154:Src/pose_pipeline.c ****         if (x < min_x) min_x = x;
 155:Src/pose_pipeline.c ****         if (x > max_x) max_x = x;
 156:Src/pose_pipeline.c ****         if (y < min_y) min_y = y;
 157:Src/pose_pipeline.c ****         if (y > max_y) max_y = y;
 158:Src/pose_pipeline.c ****     }
 159:Src/pose_pipeline.c ****     float32_t height = max_y - min_y;
 160:Src/pose_pipeline.c ****     if (height <= 0.0f) height = 0.001f;
 161:Src/pose_pipeline.c ****     return (max_x - min_x) / height;
 162:Src/pose_pipeline.c **** }
