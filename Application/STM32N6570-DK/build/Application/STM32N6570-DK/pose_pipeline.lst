 121:Src/pose_pipeline.c ****     }
 122:Src/pose_pipeline.c ****     if (y < min_y)
 123:Src/pose_pipeline.c ****     {
 124:Src/pose_pipeline.c ****       min_y = y;
 125:Src/pose_pipeline.c ****     }
 126:Src/pose_pipeline.c ****     if (y > max_y)
 127:Src/pose_pipeline.c ****     {
 128:Src/pose_pipeline.c ****       max_y = y;
