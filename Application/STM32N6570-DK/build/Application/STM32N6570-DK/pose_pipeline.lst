  87:Src/pose_pipeline.c **** /**
  88:Src/pose_pipeline.c ****  * Process one keypoint through the outlier rejection stage.
  89:Src/pose_pipeline.c ****  *
  90:Src/pose_pipeline.c ****  * @param st       Per-keypoint state (updated).
  91:Src/pose_pipeline.c ****  * @param raw      Raw keypoint from postprocess.
  92:Src/pose_pipeline.c ****  * @param torso_l  Current torso length (normalised).
  93:Src/pose_pipeline.c ****  * @param out_x    Accepted x output.
  94:Src/pose_pipeline.c ****  * @param out_y    Accepted y output.
  95:Src/pose_pipeline.c ****  * @param out_p    Accepted confidence output.
  96:Src/pose_pipeline.c ****  * @return         1 if output is valid, 0 if invalid (no hold available).
  97:Src/pose_pipeline.c ****  */
  98:Src/pose_pipeline.c **** static uint8_t outlier_process(OutlierKP_t *st,
  99:Src/pose_pipeline.c ****                                 const spe_pp_outBuffer_t *raw,
 100:Src/pose_pipeline.c ****                                 float32_t torso_l,
 101:Src/pose_pipeline.c ****                                 float32_t *out_x,
 102:Src/pose_pipeline.c ****                                 float32_t *out_y,
 103:Src/pose_pipeline.c ****                                 float32_t *out_p)
 104:Src/pose_pipeline.c **** {
 105:Src/pose_pipeline.c ****     float32_t x = raw->x_center;
 106:Src/pose_pipeline.c ****     float32_t y = raw->y_center;
 107:Src/pose_pipeline.c ****     float32_t p = raw->proba;
 108:Src/pose_pipeline.c **** 
 109:Src/pose_pipeline.c ****     uint8_t accepted = 0;
 110:Src/pose_pipeline.c **** 
 111:Src/pose_pipeline.c ****     /* --- confidence gating ---------------------------------------- */
 112:Src/pose_pipeline.c ****     if (p >= POSE_OUTLIER_HIGH_THRESH)
 113:Src/pose_pipeline.c ****     {
 114:Src/pose_pipeline.c ****         /* Definitely visible: apply geometric checks */
 115:Src/pose_pipeline.c ****         accepted = 1;
 116:Src/pose_pipeline.c ****     }
 117:Src/pose_pipeline.c ****     else if (p >= POSE_OUTLIER_INITIAL_THRESH)
 118:Src/pose_pipeline.c ****     {
 119:Src/pose_pipeline.c ****         /* Borderline: accept only if geometric checks pass */
 120:Src/pose_pipeline.c ****         accepted = 1; /* will be revoked below if checks fail */
 121:Src/pose_pipeline.c ****     }
 122:Src/pose_pipeline.c ****     else
 123:Src/pose_pipeline.c ****     {
 124:Src/pose_pipeline.c ****         /* Below minimum threshold – reject immediately */
 125:Src/pose_pipeline.c ****         goto reject;
 126:Src/pose_pipeline.c ****     }
 127:Src/pose_pipeline.c **** 
 128:Src/pose_pipeline.c ****     /* --- geometric checks (only when there is history) ------------- */
 129:Src/pose_pipeline.c ****     if (st->last_valid)
 130:Src/pose_pipeline.c ****     {
 131:Src/pose_pipeline.c ****         float32_t d = kp_dist(x, y, st->last_x, st->last_y);
 132:Src/pose_pipeline.c **** 
 133:Src/pose_pipeline.c ****         /* Speed check */
 134:Src/pose_pipeline.c ****         if (d > POSE_OUTLIER_MAX_SPEED_RATIO * torso_l)
 135:Src/pose_pipeline.c ****         {
 136:Src/pose_pipeline.c ****             accepted = 0;
 137:Src/pose_pipeline.c ****         }
 138:Src/pose_pipeline.c **** 
ARM GAS  /tmp/ccrNLpYf.s 			page 4


 139:Src/pose_pipeline.c ****         /* Consistency / radius check */
 140:Src/pose_pipeline.c ****         if (d > POSE_OUTLIER_CONSISTENCY_RATIO * torso_l)
 141:Src/pose_pipeline.c ****         {
 142:Src/pose_pipeline.c ****             accepted = 0;
 143:Src/pose_pipeline.c ****         }
 144:Src/pose_pipeline.c ****     }
 145:Src/pose_pipeline.c **** 
 146:Src/pose_pipeline.c ****     if (accepted)
 147:Src/pose_pipeline.c ****     {
 148:Src/pose_pipeline.c ****         st->last_x     = x;
 149:Src/pose_pipeline.c ****         st->last_y     = y;
 150:Src/pose_pipeline.c ****         st->last_proba = p;
 151:Src/pose_pipeline.c ****         st->last_valid  = 1;
 152:Src/pose_pipeline.c ****         st->hold_count  = 0;
 153:Src/pose_pipeline.c ****         *out_x = x;
 154:Src/pose_pipeline.c ****         *out_y = y;
 155:Src/pose_pipeline.c ****         *out_p = p;
 156:Src/pose_pipeline.c ****         return 1;
 157:Src/pose_pipeline.c ****     }
 158:Src/pose_pipeline.c **** 
 159:Src/pose_pipeline.c **** reject:
 160:Src/pose_pipeline.c ****     /* Hold last valid position */
 161:Src/pose_pipeline.c ****     if (st->last_valid && st->hold_count < POSE_OUTLIER_MAX_HOLD_FRAMES)
 162:Src/pose_pipeline.c ****     {
 163:Src/pose_pipeline.c ****         st->hold_count++;
 164:Src/pose_pipeline.c ****         *out_x = st->last_x;
 165:Src/pose_pipeline.c ****         *out_y = st->last_y;
 166:Src/pose_pipeline.c ****         *out_p = st->last_proba;
 167:Src/pose_pipeline.c ****         return 1;
 168:Src/pose_pipeline.c ****     }
 169:Src/pose_pipeline.c **** 
 170:Src/pose_pipeline.c ****     /* Exceed hold window or never had a valid position */
 171:Src/pose_pipeline.c ****     *out_x = 0.5f;
 172:Src/pose_pipeline.c ****     *out_y = 0.5f;
 173:Src/pose_pipeline.c ****     *out_p = 0.0f;
 174:Src/pose_pipeline.c ****     return 0;
 175:Src/pose_pipeline.c **** }
 176:Src/pose_pipeline.c **** 
 177:Src/pose_pipeline.c **** /* ------------------------------------------------------------------ */
 178:Src/pose_pipeline.c **** /* Step 3 – 1-Euro filter                                               */
 179:Src/pose_pipeline.c **** /* ------------------------------------------------------------------ */
 180:Src/pose_pipeline.c **** 
 181:Src/pose_pipeline.c **** /**
 182:Src/pose_pipeline.c ****  * Compute the 1-Euro low-pass filter alpha coefficient.
 183:Src/pose_pipeline.c ****  *
 184:Src/pose_pipeline.c ****  * alpha = (2*pi*cutoff*dt) / (2*pi*cutoff*dt + 1)
 185:Src/pose_pipeline.c ****  */
 186:Src/pose_pipeline.c **** static inline float32_t euro_alpha(float32_t cutoff, float32_t dt)
 187:Src/pose_pipeline.c **** {
 188:Src/pose_pipeline.c ****     float32_t tau = 1.0f / (2.0f * (float32_t)M_PI * cutoff);
 189:Src/pose_pipeline.c ****     return dt / (dt + tau);
 190:Src/pose_pipeline.c **** }
 191:Src/pose_pipeline.c **** 
 192:Src/pose_pipeline.c **** /**
 193:Src/pose_pipeline.c ****  * Run one 1-Euro filter step for a single keypoint.
 194:Src/pose_pipeline.c ****  *
 195:Src/pose_pipeline.c ****  * @param st      Filter state (updated).
ARM GAS  /tmp/ccrNLpYf.s 			page 5


 196:Src/pose_pipeline.c ****  * @param x_raw   Outlier-rejected x input.
 197:Src/pose_pipeline.c ****  * @param y_raw   Outlier-rejected y input.
 198:Src/pose_pipeline.c ****  * @param dt      Time step in seconds.
 199:Src/pose_pipeline.c ****  * @param out_x   Filtered x.
 200:Src/pose_pipeline.c ****  * @param out_y   Filtered y.
 201:Src/pose_pipeline.c ****  */
 202:Src/pose_pipeline.c **** static void euro_process(EuroKP_t *st,
 203:Src/pose_pipeline.c ****                           float32_t x_raw, float32_t y_raw,
 204:Src/pose_pipeline.c ****                           float32_t dt,
 205:Src/pose_pipeline.c ****                           float32_t *out_x, float32_t *out_y)
 206:Src/pose_pipeline.c **** {
 207:Src/pose_pipeline.c ****     if (!st->initialized)
 208:Src/pose_pipeline.c ****     {
 209:Src/pose_pipeline.c ****         st->x_hat  = x_raw;
 210:Src/pose_pipeline.c ****         st->y_hat  = y_raw;
 211:Src/pose_pipeline.c ****         st->dx_hat = 0.0f;
 212:Src/pose_pipeline.c ****         st->dy_hat = 0.0f;
 213:Src/pose_pipeline.c ****         st->initialized = 1;
 214:Src/pose_pipeline.c ****         *out_x = x_raw;
 215:Src/pose_pipeline.c ****         *out_y = y_raw;
 216:Src/pose_pipeline.c ****         return;
 217:Src/pose_pipeline.c ****     }
 218:Src/pose_pipeline.c **** 
 219:Src/pose_pipeline.c ****     /* Clamp dt to a reasonable range to avoid instability */
 220:Src/pose_pipeline.c ****     if (dt < 1e-6f) dt = 1e-6f;
 221:Src/pose_pipeline.c ****     if (dt > 1.0f)  dt = 1.0f;
 222:Src/pose_pipeline.c **** 
 223:Src/pose_pipeline.c ****     /* --- Derivative filter ---------------------------------------- */
 224:Src/pose_pipeline.c ****     float32_t a_d = euro_alpha(POSE_EURO_D_CUTOFF, dt);
 225:Src/pose_pipeline.c **** 
 226:Src/pose_pipeline.c ****     float32_t dx_raw = (x_raw - st->x_hat) / dt;
 227:Src/pose_pipeline.c ****     float32_t dy_raw = (y_raw - st->y_hat) / dt;
 228:Src/pose_pipeline.c **** 
 229:Src/pose_pipeline.c ****     float32_t dx_hat = a_d * dx_raw + (1.0f - a_d) * st->dx_hat;
 230:Src/pose_pipeline.c ****     float32_t dy_hat = a_d * dy_raw + (1.0f - a_d) * st->dy_hat;
 231:Src/pose_pipeline.c **** 
 232:Src/pose_pipeline.c ****     st->dx_hat = dx_hat;
 233:Src/pose_pipeline.c ****     st->dy_hat = dy_hat;
 234:Src/pose_pipeline.c **** 
 235:Src/pose_pipeline.c ****     /* --- Signal filter  ------------------------------------------- */
 236:Src/pose_pipeline.c ****     float32_t speed = sqrtf(dx_hat * dx_hat + dy_hat * dy_hat);
 237:Src/pose_pipeline.c **** 
 238:Src/pose_pipeline.c ****     float32_t cutoff_x = POSE_EURO_MIN_CUTOFF + POSE_EURO_BETA * fabsf(dx_hat);
 239:Src/pose_pipeline.c ****     float32_t cutoff_y = POSE_EURO_MIN_CUTOFF + POSE_EURO_BETA * fabsf(dy_hat);
 240:Src/pose_pipeline.c ****     (void)speed; /* retained for documentation; individual cutoffs used */
 241:Src/pose_pipeline.c **** 
 242:Src/pose_pipeline.c ****     float32_t a_x = euro_alpha(cutoff_x, dt);
 243:Src/pose_pipeline.c ****     float32_t a_y = euro_alpha(cutoff_y, dt);
 244:Src/pose_pipeline.c **** 
 245:Src/pose_pipeline.c ****     st->x_hat = a_x * x_raw + (1.0f - a_x) * st->x_hat;
 246:Src/pose_pipeline.c ****     st->y_hat = a_y * y_raw + (1.0f - a_y) * st->y_hat;
 247:Src/pose_pipeline.c **** 
 248:Src/pose_pipeline.c ****     *out_x = st->x_hat;
 249:Src/pose_pipeline.c ****     *out_y = st->y_hat;
 250:Src/pose_pipeline.c **** }
 251:Src/pose_pipeline.c **** 
