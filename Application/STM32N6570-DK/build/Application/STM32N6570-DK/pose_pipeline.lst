   1:Src/pose_pipeline.c **** /**
   2:Src/pose_pipeline.c ****  ******************************************************************************
   3:Src/pose_pipeline.c ****  * @file    pose_pipeline.c
   4:Src/pose_pipeline.c ****  * @brief   Pose feature window builder — Pipeline D (kp13 + velocity)
   5:Src/pose_pipeline.c ****  *
   6:Src/pose_pipeline.c ****  *  Implements the same preprocessing as train_window_phase37.py:
   7:Src/pose_pipeline.c ****  *
   8:Src/pose_pipeline.c ****  *  Step 1  Coordinate clamp to [0, 1]
   9:Src/pose_pipeline.c ****  *  Step 2  Low-confidence hold  (conf < POSE_CONF_MASK_THRESHOLD)
  10:Src/pose_pipeline.c ****  *  Step 3  One-Euro filter on coordinates  (min_cutoff=0.5, beta=0.3)
  11:Src/pose_pipeline.c ****  *  Step 4  EMA on confidence  (alpha=0.5)
  12:Src/pose_pipeline.c ****  *  Step 5  HSSC_y/x, RWHC, raw VHSSC
  13:Src/pose_pipeline.c ****  *  Step 6  EMA on VHSSC  (alpha=0.4) → VHSSC output feature
  14:Src/pose_pipeline.c ****  *  Step 7  AHSSC = d(VHSSC_ema)/dt,  AHSSC_x = d(VHSSC_x)/dt
  15:Src/pose_pipeline.c ****  *  Step 8  Assemble raw 45-feat base vector
  16:Src/pose_pipeline.c ****  *  Step 9  Velocity (29): Δ of raw base at vel_src_indices (first frame = 0)
  17:Src/pose_pipeline.c ****  *  Step 10 Concatenate [base(45), vel(29)] = 74 features
  18:Src/pose_pipeline.c ****  *  Step 11 Normalize + clip [0,1]  (P37-vel training stats)
  19:Src/pose_pipeline.c ****  ******************************************************************************
  20:Src/pose_pipeline.c ****  */
  21:Src/pose_pipeline.c **** #include "pose_pipeline.h"
  22:Src/pose_pipeline.c **** #include <string.h>
  23:Src/pose_pipeline.c **** #include <math.h>
  24:Src/pose_pipeline.c **** 
  25:Src/pose_pipeline.c **** #define POSE_TWO_PI  (6.2831853071795864769f)
ARM GAS  /tmp/ccA2Mu0s.s 			page 2


