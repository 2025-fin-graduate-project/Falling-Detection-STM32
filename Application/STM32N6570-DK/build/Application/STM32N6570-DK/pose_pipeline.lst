 106:Src/pose_pipeline.c **** /* MinMax normalization parameters — P38-nv-a65-gru (45 features) */
 107:Src/pose_pipeline.c **** static const float32_t norm_min[POSE_FEATURE_COUNT]   = POSE_NORM_MIN;
 108:Src/pose_pipeline.c **** static const float32_t norm_scale[POSE_FEATURE_COUNT] = POSE_NORM_SCALE;
 109:Src/pose_pipeline.c **** 
 110:Src/pose_pipeline.c **** static void compute_hssc(const float32_t all_kp[POSE_KP_COUNT * 3u],
 111:Src/pose_pipeline.c ****                          float32_t *hssc_x, float32_t *hssc_y)
 112:Src/pose_pipeline.c **** {
 113:Src/pose_pipeline.c ****     float32_t sum_x = 0.0f;
 114:Src/pose_pipeline.c ****     float32_t sum_y = 0.0f;
 115:Src/pose_pipeline.c ****     for (uint32_t i = 0u; i < POSE_HSSC_INDICES_COUNT; i++)
 116:Src/pose_pipeline.c ****     {
