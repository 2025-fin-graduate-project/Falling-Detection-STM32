  68:Src/pose_pipeline.c **** 
  69:Src/pose_pipeline.c **** static float32_t ema_filter_apply(PoseEmaFilter_t *f, float32_t x, float32_t alpha)
  70:Src/pose_pipeline.c **** {
  71:Src/pose_pipeline.c ****     if (!f->initialized)
  72:Src/pose_pipeline.c ****     {
  73:Src/pose_pipeline.c ****         f->x_prev      = x;
  74:Src/pose_pipeline.c ****         f->initialized = 1u;
  75:Src/pose_pipeline.c ****         return x;
  76:Src/pose_pipeline.c ****     }
  77:Src/pose_pipeline.c ****     float32_t x_hat = alpha * x + (1.0f - alpha) * f->x_prev;
