  69:Src/display_mpe.c **** #ifdef USE_BINDINGS
  70:Src/display_mpe.c **** static void Display_binding(mpe_pp_keyPoints_t *from, mpe_pp_keyPoints_t *to, uint32_t color)
  71:Src/display_mpe.c **** {
  72:Src/display_mpe.c ****   int is_clamp;
  73:Src/display_mpe.c ****   int x0, y0;
  74:Src/display_mpe.c ****   int x1, y1;
  75:Src/display_mpe.c ****   int i;
  76:Src/display_mpe.c **** 
  77:Src/display_mpe.c ****   assert(BINDING_WIDTH % 2 == 1);
  78:Src/display_mpe.c **** 
  79:Src/display_mpe.c ****   if (from->conf < AI_POSE_PP_CONF_THRESHOLD)
  80:Src/display_mpe.c ****     return ;
  81:Src/display_mpe.c ****   if (to->conf < AI_POSE_PP_CONF_THRESHOLD)
  82:Src/display_mpe.c ****     return ;
  83:Src/display_mpe.c **** 
  84:Src/display_mpe.c ****   convert_point(from->x, from->y, &x0, &y0);
  85:Src/display_mpe.c ****   is_clamp = clamp_point(&x0, &y0);
  86:Src/display_mpe.c ****   if (is_clamp)
  87:Src/display_mpe.c ****     return ;
  88:Src/display_mpe.c **** 
  89:Src/display_mpe.c ****   convert_point(to->x, to->y, &x1, &y1);
  90:Src/display_mpe.c ****   is_clamp = clamp_point(&x1, &y1);
  91:Src/display_mpe.c ****   if (is_clamp)
  92:Src/display_mpe.c ****     return ;
  93:Src/display_mpe.c **** 
  94:Src/display_mpe.c ****   UTIL_LCD_DrawLine(x0, y0, x1, y1, color);
  95:Src/display_mpe.c ****   for (i = 1; i <= (BINDING_WIDTH - 1) / 2; i++) {
  96:Src/display_mpe.c ****     if (abs(y1 - y0) > abs(x1 - x0)) {
  97:Src/display_mpe.c ****       Display_binding_line(x0 + i, y0, x1 + i , y1, color);
  98:Src/display_mpe.c ****       Display_binding_line(x0 - i, y0, x1 - i , y1, color);
  99:Src/display_mpe.c ****     } else {
 100:Src/display_mpe.c ****       Display_binding_line(x0, y0 + i, x1 , y1 + i, color);
 101:Src/display_mpe.c ****       Display_binding_line(x0, y0 - i, x1 , y1 - i, color);
 102:Src/display_mpe.c ****     }
 103:Src/display_mpe.c ****   }
 104:Src/display_mpe.c **** 
 105:Src/display_mpe.c ****   Display_keypoint(from, color);
 106:Src/display_mpe.c ****   Display_keypoint(to, color);
 107:Src/display_mpe.c **** }
